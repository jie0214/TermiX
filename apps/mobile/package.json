{
  "name": "@termix/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "npm run test:domain && npm run test:ui",
    "test:domain": "node --test tests/*.test.ts",
    "test:ui": "jest --runInBand",
    "export": "expo export --platform ios --platform android",
    "build:terminal": "node scripts/build-terminal.mjs",
    "build:ssh:ios": "bash scripts/build-ssh.sh ios",
    "build:ssh:android": "bash scripts/build-ssh.sh android",
    "postinstall": "npm run build:terminal",
    "preios": "npm run build:terminal && npm run build:ssh:ios",
    "preandroid": "npm run build:terminal && npm run build:ssh:android",
    "preexport": "npm run build:terminal",
    "test:ssh": "cd native/ssh && go test -race ./...",
    "archive:ios": "bash scripts/archive-ios.sh",
    "test:terminal": "npm run build:terminal && playwright test"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
