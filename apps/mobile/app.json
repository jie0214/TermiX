{
  "expo": {
    "name": "TermiX",
    "slug": "termix-mobile",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jie0214.termix.mobile",
      "buildNumber": "3"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.jie0214.termix.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "scheme": "termix",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
